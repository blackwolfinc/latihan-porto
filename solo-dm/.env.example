# Salin ke .env lalu isi. Untuk main tanpa API, cukup set DM_MOCK=1.

# Kunci API DeepSeek (https://platform.deepseek.com).
DEEPSEEK_API_KEY=

# Mode mock: 1 = jalan penuh tanpa API key (parser kata kunci, narasi placeholder).
# Set 0 untuk memakai LLM sungguhan.
DM_MOCK=1

# Nama model — JANGAN pakai deepseek-chat / deepseek-reasoner (pensiun 24 Jul 2026).
DM_MODEL_FLASH=deepseek-v4-flash
DM_MODEL_PRO=deepseek-v4-pro
