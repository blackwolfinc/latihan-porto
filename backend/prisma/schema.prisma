generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Organization {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  logo        String?
  address     String?
  city        String?
  phone       String?
  email       String?
  website     String?
  taxId       String?  // NPWP
  plan        SaasPlan @default(STARTER)
  isActive    Boolean  @default(true)
  trialEndsAt DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  branches    Branch[]
  users       User[]
  invoices    Invoice[]

  @@map("organizations")
}

enum SaasPlan {
  STARTER
  PROFESSIONAL
  ENTERPRISE
}

enum Role {
  ADMIN
  MANAGER
  STAFF
  DRIVER
  CUSTOMER
}

enum CarStatus {
  AVAILABLE
  RENTED
  MAINTENANCE
  INACTIVE
}

enum CarCategory {
  SEDAN
  SUV
  MPV
  BUS
  PICKUP
  VAN
  LUXURY
}

enum Transmission {
  MANUAL
  AUTOMATIC
}

enum FuelType {
  BENSIN
  DIESEL
  ELECTRIC
  HYBRID
}

enum BookingStatus {
  PENDING
  CONFIRMED
  ACTIVE
  COMPLETED
  CANCELLED
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
  EXPIRED
}

enum DriverStatus {
  AVAILABLE
  ON_TRIP
  OFF_DUTY
}

enum DocumentType {
  STNK
  KIR
  INSURANCE
  SIM
  KTP
  SKCK
}

enum MaintenanceType {
  ROUTINE
  REPAIR
  INSPECTION
}

enum InspectionType {
  PRE_RENTAL
  POST_RENTAL
}

model User {
  id              String        @id @default(cuid())
  email           String        @unique
  password        String
  name            String
  phone           String?
  role            Role          @default(CUSTOMER)
  avatar          String?
  isActive        Boolean       @default(true)
  organizationId  String?
  organization    Organization? @relation(fields: [organizationId], references: [id])
  branchId        String?
  branch          Branch?       @relation(fields: [branchId], references: [id])
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  driver        Driver?
  bookings      Booking[] @relation("CustomerBookings")
  reviews       Review[]
  notifications Notification[]
  inspections   Inspection[] @relation("InspectorInspections")

  @@map("users")
}

model Branch {
  id              String        @id @default(cuid())
  name            String
  address         String
  city            String
  phone           String?
  lat             Float?
  lng             Float?
  isActive        Boolean       @default(true)
  organizationId  String?
  organization    Organization? @relation(fields: [organizationId], references: [id])
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  users     User[]
  cars      Car[]
  bookings  Booking[]
  expenses  Expense[]

  @@map("branches")
}

model Car {
  id           String       @id @default(cuid())
  brand        String
  model        String
  year         Int
  plateNumber  String       @unique
  color        String
  category     CarCategory
  status       CarStatus    @default(AVAILABLE)
  branchId     String
  branch       Branch       @relation(fields: [branchId], references: [id])
  dailyRate    Decimal      @db.Decimal(12, 2)
  imageUrls    String[]
  seatCount    Int
  transmission Transmission
  fuelType     FuelType
  odometer     Int          @default(0)
  description  String?
  isActive     Boolean      @default(true)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  documents    CarDocument[]
  bookings     Booking[]
  gpsLogs      GpsLog[]
  maintenance  MaintenanceRecord[]
  fuelLogs     FuelLog[]
  inspections  Inspection[]
  expenses     Expense[]

  @@map("cars")
}

model CarDocument {
  id         String       @id @default(cuid())
  carId      String
  car        Car          @relation(fields: [carId], references: [id])
  type       DocumentType
  number     String
  expiryDate DateTime
  fileUrl    String
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt

  @@map("car_documents")
}

model Driver {
  id            String       @id @default(cuid())
  userId        String       @unique
  user          User         @relation(fields: [userId], references: [id])
  licenseNumber String
  licenseType   String
  licenseExpiry DateTime
  status        DriverStatus @default(AVAILABLE)
  ratingAvg     Float        @default(0)
  totalTrips    Int          @default(0)
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  documents  DriverDocument[]
  bookings   Booking[]
  fuelLogs   FuelLog[]
  reviews    Review[]

  @@map("drivers")
}

model DriverDocument {
  id         String       @id @default(cuid())
  driverId   String
  driver     Driver       @relation(fields: [driverId], references: [id])
  type       DocumentType
  number     String
  expiryDate DateTime
  fileUrl    String
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt

  @@map("driver_documents")
}

model Booking {
  id              String        @id @default(cuid())
  customerId      String
  customer        User          @relation("CustomerBookings", fields: [customerId], references: [id])
  carId           String
  car             Car           @relation(fields: [carId], references: [id])
  driverId        String?
  driver          Driver?       @relation(fields: [driverId], references: [id])
  branchId        String
  branch          Branch        @relation(fields: [branchId], references: [id])
  startDate       DateTime
  endDate         DateTime
  pickupLocation  String
  dropoffLocation String
  status          BookingStatus @default(PENDING)
  withDriver      Boolean       @default(false)
  totalAmount     Decimal       @db.Decimal(12, 2)
  notes           String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  payment     Payment?
  inspections Inspection[]
  reviews     Review[]
  contract    Contract?
  gpsLogs     GpsLog[]
  invoices    Invoice[]

  @@map("bookings")
}

model Payment {
  id                    String        @id @default(cuid())
  bookingId             String        @unique
  booking               Booking       @relation(fields: [bookingId], references: [id])
  amount                Decimal       @db.Decimal(12, 2)
  method                String?
  midtransTransactionId String?
  midtransOrderId       String        @unique
  status                PaymentStatus @default(PENDING)
  snapToken             String?
  snapRedirectUrl       String?
  paidAt                DateTime?
  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt

  @@map("payments")
}

model GpsLog {
  id         String   @id @default(cuid())
  carId      String
  car        Car      @relation(fields: [carId], references: [id])
  bookingId  String?
  booking    Booking? @relation(fields: [bookingId], references: [id])
  lat        Float
  lng        Float
  speed      Float?
  heading    Float?
  recordedAt DateTime @default(now())

  @@index([carId, recordedAt])
  @@map("gps_logs")
}

model MaintenanceRecord {
  id          String          @id @default(cuid())
  carId       String
  car         Car             @relation(fields: [carId], references: [id])
  type        MaintenanceType
  description String
  cost        Decimal         @db.Decimal(12, 2)
  date        DateTime
  nextDueDate DateTime?
  odometer    Int?
  vendor      String?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  @@map("maintenance_records")
}

model FuelLog {
  id        String   @id @default(cuid())
  carId     String
  car       Car      @relation(fields: [carId], references: [id])
  driverId  String?
  driver    Driver?  @relation(fields: [driverId], references: [id])
  liters    Float
  cost      Decimal  @db.Decimal(12, 2)
  odometer  Int
  date      DateTime
  fuelType  FuelType
  createdAt DateTime @default(now())

  @@map("fuel_logs")
}

model Inspection {
  id             String         @id @default(cuid())
  bookingId      String
  booking        Booking        @relation(fields: [bookingId], references: [id])
  carId          String
  car            Car            @relation(fields: [carId], references: [id])
  type           InspectionType
  inspectorId    String
  inspector      User           @relation("InspectorInspections", fields: [inspectorId], references: [id])
  exteriorStatus String
  interiorStatus String
  engineStatus   String?
  notes          String?
  damagePhotos   String[]
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  @@map("inspections")
}

model Review {
  id         String   @id @default(cuid())
  bookingId  String
  booking    Booking  @relation(fields: [bookingId], references: [id])
  customerId String
  customer   User     @relation(fields: [customerId], references: [id])
  driverId   String?
  driver     Driver?  @relation(fields: [driverId], references: [id])
  rating     Int
  comment    String?
  createdAt  DateTime @default(now())

  @@map("reviews")
}

model Contract {
  id           String   @id @default(cuid())
  bookingId    String   @unique
  booking      Booking  @relation(fields: [bookingId], references: [id])
  terms        String
  signedAt     DateTime?
  signatureUrl String?
  pdfUrl       String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@map("contracts")
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  title     String
  body      String
  type      String
  isRead    Boolean  @default(false)
  data      Json?
  createdAt DateTime @default(now())

  @@index([userId, isRead])
  @@map("notifications")
}

model Expense {
  id          String   @id @default(cuid())
  branchId    String
  branch      Branch   @relation(fields: [branchId], references: [id])
  carId       String?
  car         Car?     @relation(fields: [carId], references: [id])
  category    String
  amount      Decimal  @db.Decimal(12, 2)
  description String
  date        DateTime
  receiptUrl  String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("expenses")
}

enum InvoiceStatus {
  DRAFT
  SENT
  PAID
  OVERDUE
  CANCELLED
}

model Invoice {
  id              String        @id @default(cuid())
  organizationId  String
  organization    Organization  @relation(fields: [organizationId], references: [id])
  bookingId       String
  booking         Booking       @relation(fields: [bookingId], references: [id])
  invoiceNumber   String        @unique
  issueDate       DateTime      @default(now())
  dueDate         DateTime
  subtotal        Decimal       @db.Decimal(12, 2)
  taxRate         Decimal       @db.Decimal(5, 2) @default(11)
  taxAmount       Decimal       @db.Decimal(12, 2)
  discount        Decimal       @db.Decimal(12, 2) @default(0)
  totalAmount     Decimal       @db.Decimal(12, 2)
  status          InvoiceStatus @default(DRAFT)
  notes           String?
  paidAt          DateTime?
  pdfUrl          String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  items           InvoiceItem[]

  @@map("invoices")
}

model InvoiceItem {
  id          String  @id @default(cuid())
  invoiceId   String
  invoice     Invoice @relation(fields: [invoiceId], references: [id])
  description String
  quantity    Int
  unitPrice   Decimal @db.Decimal(12, 2)
  amount      Decimal @db.Decimal(12, 2)

  @@map("invoice_items")
}
