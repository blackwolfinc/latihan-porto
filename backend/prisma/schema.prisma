generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-1.0.x", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Organization {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  logo        String?
  address     String?
  city        String?
  phone       String?
  email       String?
  website     String?
  taxId       String?  // NPWP
  plan        SaasPlan @default(FREE)
  isActive    Boolean  @default(true)
  trialEndsAt DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  branches    Branch[]
  users       User[]
  invoices    Invoice[]
  invoiceTemplate InvoiceTemplate?
  subscription Subscription?

  @@map("organizations")
}

model Subscription {
  id               String   @id @default(cuid())
  organizationId   String   @unique
  organization     Organization @relation(fields: [organizationId], references: [id])
  plan             SaasPlan @default(FREE)
  status           SubscriptionStatus @default(ACTIVE)
  currentPeriodStart DateTime @default(now())
  currentPeriodEnd   DateTime?
  cancelledAt      DateTime?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@map("subscriptions")
}

enum SubscriptionStatus {
  ACTIVE
  PAST_DUE
  CANCELLED
  TRIALING
}

enum SaasPlan {
  FREE
  STANDARD
  PREMIUM
}

enum Role {
  ADMIN
  MANAGER
  STAFF
  DRIVER
  CUSTOMER
}

enum CarStatus {
  AVAILABLE
  RENTED
  MAINTENANCE
  INACTIVE
}

enum CarCategory {
  SEDAN
  SUV
  MPV
  BUS
  PICKUP
  VAN
  LUXURY
}

enum Transmission {
  MANUAL
  AUTOMATIC
}

enum FuelType {
  BENSIN
  DIESEL
  ELECTRIC
  HYBRID
}

enum VehicleType {
  CAR
  MOTORCYCLE
}

enum BookingStatus {
  PENDING
  CONFIRMED
  ACTIVE
  COMPLETED
  CANCELLED
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
  EXPIRED
}

enum DriverStatus {
  AVAILABLE
  ON_TRIP
  OFF_DUTY
}

enum DocumentType {
  STNK
  KIR
  INSURANCE
  SIM
  KTP
  SKCK
}

enum MaintenanceType {
  ROUTINE
  REPAIR
  INSPECTION
}

enum InspectionType {
  PRE_RENTAL
  POST_RENTAL
}

model User {
  id              String        @id @default(cuid())
  email           String        @unique
  password        String
  name            String
  phone           String?
  role            Role          @default(CUSTOMER)
  avatar          String?
  isActive        Boolean       @default(true)
  organizationId  String?
  organization    Organization? @relation(fields: [organizationId], references: [id])
  branchId        String?
  branch          Branch?       @relation(fields: [branchId], references: [id])
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  driver           Driver?
  bookings         Booking[] @relation("CustomerBookings")
  reviews          Review[]
  notifications    Notification[]
  inspections      Inspection[] @relation("InspectorInspections")
  verification     CustomerVerification?
  blacklistReports CustomerBlacklist[] @relation("BlacklistReporter")

  @@map("users")
}

model Branch {
  id              String        @id @default(cuid())
  name            String
  address         String
  city            String
  phone           String?
  lat             Float?
  lng             Float?
  isActive        Boolean       @default(true)
  organizationId  String?
  organization    Organization? @relation(fields: [organizationId], references: [id])
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  users     User[]
  cars      Car[]
  bookings  Booking[]
  expenses  Expense[]

  @@map("branches")
}

model Car {
  id           String       @id @default(cuid())
  brand        String
  model        String
  year         Int
  plateNumber  String       @unique
  color        String
  vehicleType  VehicleType  @default(CAR)
  category     CarCategory
  status       CarStatus    @default(AVAILABLE)
  branchId     String
  branch       Branch       @relation(fields: [branchId], references: [id])
  dailyRate    Decimal      @db.Decimal(12, 2)
  imageUrls    String[]
  seatCount    Int
  transmission Transmission
  fuelType     FuelType
  odometer     Int          @default(0)
  description  String?
  isActive     Boolean      @default(true)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  documents    CarDocument[]
  bookings     Booking[]
  gpsLogs      GpsLog[]
  maintenance  MaintenanceRecord[]
  fuelLogs     FuelLog[]
  inspections  Inspection[]
  expenses     Expense[]

  @@map("cars")
}

model CarDocument {
  id         String       @id @default(cuid())
  carId      String
  car        Car          @relation(fields: [carId], references: [id])
  type       DocumentType
  number     String
  expiryDate DateTime
  fileUrl    String
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt

  @@map("car_documents")
}

model Driver {
  id            String       @id @default(cuid())
  userId        String       @unique
  user          User         @relation(fields: [userId], references: [id])
  licenseNumber String
  licenseType   String
  licenseExpiry DateTime
  status        DriverStatus @default(AVAILABLE)
  ratingAvg     Float        @default(0)
  totalTrips    Int          @default(0)
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  documents  DriverDocument[]
  bookings   Booking[]
  fuelLogs   FuelLog[]
  reviews    Review[]

  @@map("drivers")
}

model DriverDocument {
  id         String       @id @default(cuid())
  driverId   String
  driver     Driver       @relation(fields: [driverId], references: [id])
  type       DocumentType
  number     String
  expiryDate DateTime
  fileUrl    String
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt

  @@map("driver_documents")
}

model Booking {
  id              String        @id @default(cuid())
  customerId      String
  customer        User          @relation("CustomerBookings", fields: [customerId], references: [id])
  carId           String
  car             Car           @relation(fields: [carId], references: [id])
  driverId        String?
  driver          Driver?       @relation(fields: [driverId], references: [id])
  branchId        String
  branch          Branch        @relation(fields: [branchId], references: [id])
  startDate       DateTime
  endDate         DateTime
  pickupLocation  String
  dropoffLocation String
  status          BookingStatus @default(PENDING)
  withDriver      Boolean       @default(false)
  totalAmount     Decimal       @db.Decimal(12, 2)
  notes           String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  payment     Payment?
  inspections Inspection[]
  reviews     Review[]
  contract    Contract?
  gpsLogs     GpsLog[]
  invoices    Invoice[]

  @@map("bookings")
}

model Payment {
  id                    String        @id @default(cuid())
  bookingId             String        @unique
  booking               Booking       @relation(fields: [bookingId], references: [id])
  amount                Decimal       @db.Decimal(12, 2)
  method                String?
  midtransTransactionId String?
  midtransOrderId       String        @unique
  status                PaymentStatus @default(PENDING)
  snapToken             String?
  snapRedirectUrl       String?
  paidAt                DateTime?
  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt

  @@map("payments")
}

model GpsLog {
  id         String   @id @default(cuid())
  carId      String
  car        Car      @relation(fields: [carId], references: [id])
  bookingId  String?
  booking    Booking? @relation(fields: [bookingId], references: [id])
  lat        Float
  lng        Float
  speed      Float?
  heading    Float?
  recordedAt DateTime @default(now())

  @@index([carId, recordedAt])
  @@map("gps_logs")
}

model MaintenanceRecord {
  id          String          @id @default(cuid())
  carId       String
  car         Car             @relation(fields: [carId], references: [id])
  type        MaintenanceType
  description String
  cost        Decimal         @db.Decimal(12, 2)
  date        DateTime
  nextDueDate DateTime?
  odometer    Int?
  vendor      String?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  @@map("maintenance_records")
}

model FuelLog {
  id        String   @id @default(cuid())
  carId     String
  car       Car      @relation(fields: [carId], references: [id])
  driverId  String?
  driver    Driver?  @relation(fields: [driverId], references: [id])
  liters    Float
  cost      Decimal  @db.Decimal(12, 2)
  odometer  Int
  date      DateTime
  fuelType  FuelType
  createdAt DateTime @default(now())

  @@map("fuel_logs")
}

model Inspection {
  id             String         @id @default(cuid())
  bookingId      String
  booking        Booking        @relation(fields: [bookingId], references: [id])
  carId          String
  car            Car            @relation(fields: [carId], references: [id])
  type           InspectionType
  inspectorId    String
  inspector      User           @relation("InspectorInspections", fields: [inspectorId], references: [id])
  exteriorStatus String
  interiorStatus String
  engineStatus   String?
  notes          String?
  damagePhotos   String[]
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  @@map("inspections")
}

model Review {
  id         String   @id @default(cuid())
  bookingId  String
  booking    Booking  @relation(fields: [bookingId], references: [id])
  customerId String
  customer   User     @relation(fields: [customerId], references: [id])
  driverId   String?
  driver     Driver?  @relation(fields: [driverId], references: [id])
  rating     Int
  comment    String?
  createdAt  DateTime @default(now())

  @@map("reviews")
}

model Contract {
  id           String   @id @default(cuid())
  bookingId    String   @unique
  booking      Booking  @relation(fields: [bookingId], references: [id])
  terms        String
  signedAt     DateTime?
  signatureUrl String?
  pdfUrl       String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@map("contracts")
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  title     String
  body      String
  type      String
  isRead    Boolean  @default(false)
  data      Json?
  createdAt DateTime @default(now())

  @@index([userId, isRead])
  @@map("notifications")
}

model Expense {
  id          String   @id @default(cuid())
  branchId    String
  branch      Branch   @relation(fields: [branchId], references: [id])
  carId       String?
  car         Car?     @relation(fields: [carId], references: [id])
  category    String
  amount      Decimal  @db.Decimal(12, 2)
  description String
  date        DateTime
  receiptUrl  String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("expenses")
}

enum InvoiceStatus {
  DRAFT
  SENT
  PAID
  OVERDUE
  CANCELLED
}

model Invoice {
  id              String        @id @default(cuid())
  organizationId  String
  organization    Organization  @relation(fields: [organizationId], references: [id])
  bookingId       String
  booking         Booking       @relation(fields: [bookingId], references: [id])
  invoiceNumber   String        @unique
  issueDate       DateTime      @default(now())
  dueDate         DateTime
  subtotal        Decimal       @db.Decimal(12, 2)
  taxRate         Decimal       @db.Decimal(5, 2) @default(11)
  taxAmount       Decimal       @db.Decimal(12, 2)
  discount        Decimal       @db.Decimal(12, 2) @default(0)
  totalAmount     Decimal       @db.Decimal(12, 2)
  status          InvoiceStatus @default(DRAFT)
  notes           String?
  paidAt          DateTime?
  pdfUrl          String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  items           InvoiceItem[]

  @@map("invoices")
}

model InvoiceItem {
  id          String  @id @default(cuid())
  invoiceId   String
  invoice     Invoice @relation(fields: [invoiceId], references: [id])
  description String
  quantity    Int
  unitPrice   Decimal @db.Decimal(12, 2)
  amount      Decimal @db.Decimal(12, 2)

  @@map("invoice_items")
}

model InvoiceTemplate {
  id               String   @id @default(cuid())
  organizationId   String   @unique
  organization     Organization @relation(fields: [organizationId], references: [id])

  // Company Branding
  logoUrl          String?
  companyName      String
  companyTagline   String?  // e.g. "Solusi Rental Mobil Terpercaya"

  // Kop Surat / Letterhead
  headerAddress    String?
  headerCity       String?
  headerPhone      String?
  headerEmail      String?
  headerWebsite    String?
  headerNpwp       String?  // NPWP perusahaan

  // Invoice Styling
  primaryColor     String   @default("#1a56db")  // Hex color for header/accents
  secondaryColor   String   @default("#6b7280")

  // Signature
  signatureName    String?   // Nama penandatangan
  signatureTitle   String?   // Jabatan (e.g. "Direktur Utama", "Finance Manager")
  signatureImageUrl String?  // Gambar tanda tangan digital
  stampImageUrl    String?   // Gambar stempel perusahaan

  // Bank Account for Payment
  bankName         String?   // e.g. "Bank BCA"
  bankAccountNumber String?  // e.g. "123-456-7890"
  bankAccountName  String?   // e.g. "PT CaritaHub Rental Indonesia"
  bankBranch       String?   // e.g. "KCP Jakarta Pusat"

  // Additional bank accounts (JSON array)
  additionalBanks  Json?     // [{ bankName, accountNumber, accountName }]

  // Terms & Conditions
  termsAndConditions String?  // Rich text for T&C on invoice
  paymentTerms     String?   // e.g. "Pembayaran dilakukan dalam 7 hari kerja"

  // Footer
  footerText       String?   // e.g. "Terima kasih atas kepercayaan Anda"
  footerNote       String?   // Additional note

  // Invoice Number Format
  invoicePrefix    String   @default("INV")  // e.g. "INV", "FAK", custom
  invoiceNumberFormat String @default("{PREFIX}-{YYYYMMDD}-{SEQ}")

  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@map("invoice_templates")
}

enum VerificationStatus {
  PENDING
  IN_REVIEW
  VERIFIED
  REJECTED
}

enum BlacklistReason {
  FRAUD
  THEFT
  DAMAGE
  NON_PAYMENT
  TRAFFIC_VIOLATION
  ACCIDENT
  OVERDUE
  OTHER
}

model CustomerVerification {
  id                 String             @id @default(cuid())
  userId             String             @unique
  user               User               @relation(fields: [userId], references: [id])
  ktpNumber          String?
  ktpName            String?
  ktpAddress         String?
  ktpPhotoUrl        String?
  ktpVerified        Boolean            @default(false)
  simNumber          String?
  simType            String?
  simExpiryDate      DateTime?
  simPhotoUrl        String?
  simVerified        Boolean            @default(false)
  selfiePhotoUrl     String?
  verificationStatus VerificationStatus @default(PENDING)
  verifiedBy         String?
  verifiedAt         DateTime?
  rejectionReason    String?
  riskScore          Int                @default(0)
  notes              String?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  @@map("customer_verifications")
}

model CustomerBlacklist {
  id          String          @id @default(cuid())
  ktpNumber   String?
  simNumber   String?
  name        String
  phone       String?
  reason      BlacklistReason
  description String
  reportedBy  String
  reporter    User            @relation("BlacklistReporter", fields: [reportedBy], references: [id])
  isActive    Boolean         @default(true)
  expiresAt   DateTime?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  @@map("customer_blacklists")
}
