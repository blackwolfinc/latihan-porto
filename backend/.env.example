# === Railway Configuration ===
# Railway provides these automatically when you add a PostgreSQL service:
# DATABASE_URL, PGHOST, PGPORT, PGUSER, PGPASSWORD, PGDATABASE
# For local development, set manually:
DATABASE_URL=postgresql://rental_user:rental_password@localhost:5432/rental_db

# Railway assigns PORT automatically, no need to set in Railway dashboard
# For local development:
PORT=3000

# Node environment
NODE_ENV=development

# === JWT ===
JWT_SECRET=your-super-secret-jwt-key
JWT_REFRESH_SECRET=your-super-secret-refresh-key
JWT_EXPIRATION=15m
JWT_REFRESH_EXPIRATION=7d

# === Midtrans Payment Gateway ===
MIDTRANS_SERVER_KEY=SB-Mid-server-xxxxx
MIDTRANS_CLIENT_KEY=SB-Mid-client-xxxxx
MIDTRANS_IS_PRODUCTION=false

# === Object Storage (Cloudflare R2 recommended for Railway) ===
MINIO_ENDPOINT=your-r2-account-id.r2.cloudflarestorage.com
MINIO_PORT=443
MINIO_ACCESS_KEY=your-r2-access-key
MINIO_SECRET_KEY=your-r2-secret-key
MINIO_BUCKET=rental-uploads

# === Redis (add Redis plugin in Railway) ===
REDIS_HOST=localhost
REDIS_PORT=6379

# === Email ===
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USER=your-email@gmail.com
MAIL_PASS=your-app-password

# === CORS (set to your Vercel frontend URL) ===
CORS_ORIGINS=http://localhost:5173,https://your-app.vercel.app
